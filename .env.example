# Map style (MapLibre style JSON). Default: OpenFreeMap "liberty".
NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
# Identify the app to Overpass (required by the public servers).
OVERPASS_USER_AGENT=WheelPath/0.1 (accessibility research prototype, Valenzuela City)

# --- Community reports (Supabase). Leave empty to use the local .wheelpath-data folder during development.
# Supabase -> Project Settings -> API: the Project URL and the service_role (or "secret") key.
# The key is used on the server only. Never put it in a NEXT_PUBLIC_ variable.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET=report-photos

# Signs the sign-in cookie. Use any long random text (e.g. `openssl rand -hex 32`).
SESSION_SECRET=
